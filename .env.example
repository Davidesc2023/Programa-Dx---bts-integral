# Variables de entorno — copiar a .env y completar valores
# En Vercel: configurar en el dashboard → Settings → Environment Variables

# ─── Base de datos ───────────────────────────────────────────────────────────
# Supabase App_DX (proyecto: wwosggahpasvoexshrdl, región: us-east-2)
# Dashboard → Settings → Database → Connection string → URI
# Reemplaza [PASSWORD] con la contraseña del proyecto.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.wwosggahpasvoexshrdl.supabase.co:5432/postgres"

# ─── Entorno ─────────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generar: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTE_SECRETO_ACCESS_POR_UNO_SEGURO_DE_64_CHARS_O_MAS
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=CAMBIA_ESTE_SECRETO_REFRESH_POR_UNO_SEGURO_DE_64_CHARS_O_MAS
JWT_REFRESH_EXPIRES_IN=7d

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Cloudflare R2 — configurar en Vercel dashboard
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL del frontend en Vercel. Para múltiples orígenes separar con coma.
# Ejemplo: https://tu-app.vercel.app,https://www.tu-dominio.com
CORS_ORIGIN=https://tu-frontend.vercel.app

