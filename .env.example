# Variables de entorno — APP-DX v2.0
# Copiar a .env.local y completar valores reales. NUNCA commitear .env.local al repositorio.

# ─── Frontend (Vercel env vars) ───────────────────────────────────────────────
# URL del backend (Supabase Edge Function) — REQUERIDA PARA SSR Y PROXY
# IMPORTANTE: En Vercel configurar AMBAS variables con el mismo valor:
#   BACKEND_URL              → usada por proxy /api/* y páginas SSR (autorizar, solicitud)
#   NEXT_PUBLIC_BACKEND_URL  → fallback y referencia cliente (no expone datos sensibles)
BACKEND_URL=https://wwosggahpasvoexshrdl.supabase.co/functions/v1/api
NEXT_PUBLIC_BACKEND_URL=https://wwosggahpasvoexshrdl.supabase.co/functions/v1/api

# ─── Backend (Supabase Edge Function secrets) ────────────────────────────────
# Generados con: openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTE_SECRETO_ACCESS_POR_UNO_SEGURO
JWT_REFRESH_SECRET=CAMBIA_ESTE_SECRETO_REFRESH_POR_UNO_SEGURO

# Expiración de magic links en horas (default: 72)
MAGIC_LINK_EXPIRY_HOURS=72

# CORS: URL del frontend en Vercel
CORS_ORIGIN=https://programa-dx-bts-integral.vercel.app

# Supabase (disponibles automáticamente en Edge Functions, pero útiles para scripts locales)
SUPABASE_URL=https://wwosggahpasvoexshrdl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=OBTENER_EN_SUPABASE_DASHBOARD_SETTINGS_API
SUPABASE_ANON_KEY=OBTENER_EN_SUPABASE_DASHBOARD_SETTINGS_API

# ─── CI/CD (GitHub Actions secrets) ─────────────────────────────────────────
# Configurar en: GitHub repo → Settings → Secrets and variables → Actions
# SUPABASE_ACCESS_TOKEN  ← Supabase Dashboard → Account → Access Tokens
# SUPABASE_PROJECT_ID    ← wwosggahpasvoexshrdl
# VERCEL_TOKEN           ← Vercel Dashboard → Settings → Tokens
# VERCEL_ORG_ID          ← Vercel Dashboard → Settings → General
# VERCEL_PROJECT_ID      ← prj_zhkvLBtI6incOSGZCiEHgtqBGXkW
